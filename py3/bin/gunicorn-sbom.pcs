#!/usr/bin/env python

from bisos.sbom import pkgsSeed  # pkgsSeed.plantWithWhich("seedSbom.cs")
ap = pkgsSeed.aptPkg
pp = pkgsSeed.pipPkg

# The BISOS shared venv for Python programs (the cbm-package-authorship rule: asc unless a conflict).
pkgsSeed.pkgsSeedInfo.virtenv = "/bisos/venv/py3/asc"

aptPkgsList = [
    # ap("aptPkgName"),
]

pipPkgsList = [
    pp("gunicorn"),
]

pipxPkgsList = [
    # pp("pipPkgName"),
]

pkgsSeed.setup(
    aptPkgsList=aptPkgsList,
    pipPkgsList=pipPkgsList,
    pipxPkgsList=pipxPkgsList,

)
